# Clever Cloud MySQL. El plan admite como máximo 5 conexiones simultáneas.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CONNECTION_LIMIT=5

# Firma de los JWT. Cámbiala en Vercel.
JWT_SECRET=

# Orígenes permitidos, separados por coma.
CORS_ORIGIN=https://bakepulsee.vercel.app,http://localhost:5173

# Tope de peticiones HTTP por sesión de navegador.
SESSION_REQUEST_LIMIT=5
