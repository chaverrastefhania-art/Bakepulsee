{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend-bakepulse": {
      "root": "backend-bakepulse",
      "framework": "express"
    },
    "frontend-bakepulse": {
      "root": "frontend-bakepulse",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend-bakepulse" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend-bakepulse" }
    }
  ]
}
